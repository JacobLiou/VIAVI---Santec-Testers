#include "resource.h"
#define APSTUDIO_READONLY_SYMBOLS
#include "afxres.h"
#undef APSTUDIO_READONLY_SYMBOLS

LANGUAGE 9, 1

IDD_POLARITYTESTAPP_DIALOG DIALOGEX 0, 0, 640, 430
STYLE DS_SETFONT | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME | WS_MINIMIZEBOX
CAPTION "Santec Polarity Driver Test (SP_* Dynamic Loading)"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    GROUPBOX        "Driver",-1,5,5,310,145
    LTEXT           "DLL:",-1,15,20,20,8
    EDITTEXT        IDC_EDIT_DLL_PATH,40,18,175,13,ES_AUTOHSCROLL
    PUSHBUTTON      "Load",IDC_BTN_LOAD_DLL,220,17,40,14
    PUSHBUTTON      "Unload",IDC_BTN_UNLOAD_DLL,263,17,45,14

    LTEXT           "Station:",-1,15,40,30,8
    EDITTEXT        IDC_EDIT_STATION,50,38,250,13,ES_AUTOHSCROLL
    LTEXT           "RLM SN:",-1,15,58,35,8
    EDITTEXT        IDC_EDIT_RLM_SERIAL,50,56,250,13,ES_AUTOHSCROLL
    LTEXT           "RDSP SN:",-1,15,76,35,8
    EDITTEXT        IDC_EDIT_RDSP_SERIAL,50,74,250,13,ES_AUTOHSCROLL
    LTEXT           "Profile:",-1,15,94,30,8
    EDITTEXT        IDC_EDIT_PROFILE,50,92,250,13,ES_AUTOHSCROLL

    LTEXT           "Status:",-1,15,114,28,8
    LTEXT           "DLL Not Loaded",IDC_STATIC_STATUS,50,114,250,8

    PUSHBUTTON      "Create",IDC_BTN_CREATE,15,128,45,16
    PUSHBUTTON      "Open",IDC_BTN_OPEN,65,128,45,16
    PUSHBUTTON      "Close",IDC_BTN_CLOSE,115,128,45,16
    PUSHBUTTON      "Destroy",IDC_BTN_DESTROY,165,128,50,16

    GROUPBOX        "Operations",-1,5,155,310,55
    PUSHBUTTON      "Snapshot",IDC_BTN_SNAPSHOT,15,170,60,18
    PUSHBUTTON      "Run Mapping",IDC_BTN_RUN_MAPPING,80,170,70,18
    PUSHBUTTON      "Cancel",IDC_BTN_CANCEL,155,170,50,18
    PUSHBUTTON      "Get Results",IDC_BTN_GET_RESULTS,210,170,70,18

    GROUPBOX        "Fiber Results",-1,320,5,315,205
    CONTROL         "",IDC_LIST_RESULTS,"SysListView32",LVS_REPORT | LVS_SINGLESEL | WS_BORDER | WS_TABSTOP,325,18,305,145
    LTEXT           "Summary / Snapshot:",-1,325,168,90,8
    EDITTEXT        IDC_EDIT_RAW,325,178,305,28,ES_MULTILINE | ES_AUTOVSCROLL | ES_READONLY | WS_VSCROLL

    GROUPBOX        "Log",-1,5,215,630,205
    EDITTEXT        IDC_EDIT_LOG,10,230,620,160,ES_MULTILINE | ES_AUTOVSCROLL | ES_READONLY | WS_VSCROLL
    PUSHBUTTON      "Clear Log",IDC_BTN_CLEAR_LOG,10,395,55,14
END
