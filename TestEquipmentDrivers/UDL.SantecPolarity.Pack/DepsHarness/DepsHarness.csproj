<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Library</OutputType>
    <!-- Pass -p:PlatformTarget=x86 for Win32 pack; default x64 -->
    <PlatformTarget Condition="'$(PlatformTarget)'==''">x64</PlatformTarget>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin\$(Configuration)\$(PlatformTarget)\</OutputPath>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
  <PropertyGroup Condition="'$(PlatformTarget)'=='x86'">
    <HardwareHint>..\..\UDL.SantecPolarity.Cli\libs\x86\Santec.Hardware.dll</HardwareHint>
  </PropertyGroup>
  <PropertyGroup Condition="'$(PlatformTarget)'!='x86'">
    <HardwareHint>..\..\UDL.SantecPolarity.Cli\libs\x64\Santec.Hardware.dll</HardwareHint>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Santec.Hardware">
      <HintPath>$(HardwareHint)</HintPath>
      <Private>true</Private>
      <SpecificVersion>false</SpecificVersion>
    </Reference>
    <Reference Include="Santec.Core">
      <HintPath>..\..\UDL.SantecPolarity.Cli\libs\common\Santec.Core.dll</HintPath>
      <Private>true</Private>
      <SpecificVersion>false</SpecificVersion>
    </Reference>
    <Reference Include="TIS.Imaging.ICImagingControl35">
      <HintPath>..\..\UDL.SantecPolarity.Cli\libs\common\TIS.Imaging.ICImagingControl35.dll</HintPath>
      <Private>true</Private>
      <SpecificVersion>false</SpecificVersion>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="OpenCvSharp4.Windows" Version="4.6.0.20220608" />
    <PackageReference Include="Zeroconf" Version="3.7.16" />
    <PackageReference Include="Nito.AsyncEx.Context" Version="5.1.2" />
    <PackageReference Include="Nito.AsyncEx.Tasks" Version="5.1.2" />
    <PackageReference Include="Nito.Disposables" Version="2.2.1" />
    <PackageReference Include="NGettext" Version="0.6.7" />
    <PackageReference Include="System.Text.Json" Version="5.0.2" />
    <PackageReference Include="System.Runtime.CompilerServices.Unsafe" Version="6.0.0" />
    <PackageReference Include="System.Memory" Version="4.5.5" />
    <PackageReference Include="System.Buffers" Version="4.5.1" />
    <PackageReference Include="System.Numerics.Vectors" Version="4.5.0" />
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="5.0.0" />
  </ItemGroup>
</Project>
