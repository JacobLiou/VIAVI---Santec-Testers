#include "resource.h"
#define APSTUDIO_READONLY_SYMBOLS
#include "afxres.h"
#undef APSTUDIO_READONLY_SYMBOLS

LANGUAGE 9, 1

IDD_PTMTESTAPP_DIALOG DIALOGEX 0, 0, 620, 420
STYLE DS_SETFONT | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME | WS_MINIMIZEBOX
CAPTION "Santec PTM Driver Test (Dynamic Loading)"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    GROUPBOX        "Connection",-1,5,5,300,120
    LTEXT           "DLL:",-1,15,20,20,8
    EDITTEXT        IDC_EDIT_DLL_PATH,40,18,170,13,ES_AUTOHSCROLL
    PUSHBUTTON      "Load",IDC_BTN_LOAD_DLL,215,17,40,14
    PUSHBUTTON      "Unload",IDC_BTN_UNLOAD_DLL,258,17,40,14

    LTEXT           "Mode:",-1,15,40,24,8
    COMBOBOX        IDC_COMBO_CONN_MODE,45,38,100,60,CBS_DROPDOWNLIST | WS_TABSTOP
    LTEXT           "Addr:",-1,15,58,24,8
    COMBOBOX        IDC_COMBO_ADDRESS,45,56,170,120,CBS_DROPDOWN | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "Enumerate",IDC_BTN_ENUMERATE,220,55,75,14

    LTEXT           "Port:",-1,15,76,20,8
    EDITTEXT        IDC_EDIT_PORT,40,74,45,13,ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "Status:",-1,100,76,28,8
    LTEXT           "DLL Not Loaded",IDC_STATIC_STATUS,132,76,160,8

    PUSHBUTTON      "Connect",IDC_BTN_CONNECT,15,95,55,18
    PUSHBUTTON      "Disconnect",IDC_BTN_DISCONNECT,75,95,55,18
    PUSHBUTTON      "Initialize",IDC_BTN_INITIALIZE,135,95,55,18

    GROUPBOX        "Operations",-1,5,130,300,95
    LTEXT           "Channels:",-1,15,148,40,8
    EDITTEXT        IDC_EDIT_CHANNELS,60,146,35,13,ES_AUTOHSCROLL | ES_NUMBER
    PUSHBUTTON      "Measure",IDC_BTN_MEASURE,105,145,55,16
    PUSHBUTTON      "Get Results",IDC_BTN_GET_RESULTS,165,145,60,16

    LTEXT           "Detect CH:",-1,15,170,40,8
    EDITTEXT        IDC_EDIT_DETECT_CH,60,168,35,13,ES_AUTOHSCROLL | ES_NUMBER
    PUSHBUTTON      "Detect",IDC_BTN_DETECT,105,167,50,16
    PUSHBUTTON      "VFL On",IDC_BTN_VFL,160,167,50,16
    PUSHBUTTON      "Laser Off",IDC_BTN_LASER_OFF,215,167,55,16

    CONTROL         "Local Mode",IDC_CHECK_LOCAL,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,15,190,60,10
    LTEXT           "SCPI:",-1,80,191,24,8
    EDITTEXT        IDC_EDIT_SCPI,108,189,125,13,ES_AUTOHSCROLL
    PUSHBUTTON      "Send",IDC_BTN_SEND_SCPI,238,188,40,14

    GROUPBOX        "Polarity Map (Out -> In)",-1,310,5,305,200
    CONTROL         "",IDC_LIST_RESULTS,"SysListView32",LVS_REPORT | LVS_SINGLESEL | WS_BORDER | WS_TABSTOP,315,18,295,130
    LTEXT           "Raw Result:",-1,315,155,50,8
    EDITTEXT        IDC_EDIT_RAW,315,166,295,32,ES_MULTILINE | ES_AUTOVSCROLL | ES_READONLY | WS_VSCROLL

    GROUPBOX        "Log",-1,5,230,610,185
    EDITTEXT        IDC_EDIT_LOG,10,245,600,145,ES_MULTILINE | ES_AUTOVSCROLL | ES_READONLY | WS_VSCROLL
    PUSHBUTTON      "Clear Log",IDC_BTN_CLEAR_LOG,10,395,55,14
END
