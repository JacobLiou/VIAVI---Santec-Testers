<Window
    x:Class="XNSApiSamples.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:XNSApiSamples"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="XNS API Samples"
    Width="1000"
    Height="600"
    mc:Ignorable="d">
    <Grid>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel
                Grid.Row="0"
                Margin="12"
                Orientation="Horizontal">
                <TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Text="Server Address:" />
                <TextBox
                    x:Name="ServerAddressTextBox"
                    Width="150"
                    Margin="12,0,0,0"
                    Text="localhost"
                    TextChanged="ServerAddressTextBox_TextChanged" />
            </StackPanel>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ListView
                    x:Name="samplesListView"
                    Grid.Column="0"
                    DisplayMemberPath="SampleName"
                    SelectionChanged="ListView_SelectionChanged" />
                <Frame
                    x:Name="sampleFrame"
                    Grid.Column="1"
                    NavigationUIVisibility="Hidden" />
            </Grid>
        </Grid>
    </Grid>
</Window>
