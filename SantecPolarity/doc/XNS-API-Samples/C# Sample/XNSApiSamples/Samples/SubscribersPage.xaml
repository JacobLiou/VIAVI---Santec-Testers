<Page
    x:Class="XNSApiSamples.Samples.SubscribersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:XNSApiSamples.Samples"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="SubscribersPage"
    d:DesignHeight="600"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel
            Grid.Row="0"
            Margin="12,12,12,0"
            Orientation="Horizontal" />
        <StackPanel
            Grid.Row="1"
            Margin="12,12,12,0"
            Orientation="Horizontal">
            <TextBlock VerticalAlignment="Center" Text="API Call:" />
            <TextBox
                x:Name="APICallTextBlock"
                Margin="12,0,0,0"
                Background="Transparent"
                BorderThickness="0"
                IsReadOnly="True"
                TextWrapping="Wrap" />
            <!--<TextBlock
                x:Name="APICallTextBlock"
                Margin="12,0,0,0"
                Text="" />-->
        </StackPanel>
        <Button
            x:Name="SetSubscriberButton"
            Grid.Row="2"
            Width="125"
            Margin="12,12,12,0"
            HorizontalAlignment="Left"
            Click="SetSubscriber_Click"
            Content="Set Subscriber" />
        <TextBlock
            Grid.Row="3"
            Margin="12,12,12,0"
            Text="Response:" />
        <RichTextBox
            x:Name="JSONResponseRichTextBox"
            Grid.Row="4"
            Margin="12,3,12,0"
            Background="Black"
            IsReadOnly="True"
            IsReadOnlyCaretVisible="False"
            VerticalScrollBarVisibility="Auto" />
    </Grid>
</Page>
