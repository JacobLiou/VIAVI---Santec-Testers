<Page
    x:Class="XNSApiSamples.Samples.MonitorForResultPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:XNSApiSamples.Samples"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="MonitorForResultPage"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel
            Grid.Row="0"
            Margin="12,12,12,0"
            Orientation="Horizontal">
            <TextBlock VerticalAlignment="Center" Text="DUT SN:" />
            <TextBox
                x:Name="DUTSerialNumberTextBox"
                Width="125"
                Margin="12,0,0,0"
                Text=""
                TextChanged="DUTSerialNumberTextBox_TextChanged" />
            <CheckBox
                x:Name="DUTSerialNumberCaseSensitiveCheckBox"
                Margin="12,0,0,0"
                VerticalAlignment="Center"
                Content="Case Sensitive"
                IsChecked="true" />
        </StackPanel>
        <StackPanel Grid.Row="1" Margin="12,12,12,0">
            <StackPanel Orientation="Horizontal">
                <TextBlock VerticalAlignment="Center" Text="API Calls:" />
                <TextBlock
                    Margin="12,0,0,0"
                    VerticalAlignment="Center"
                    Foreground="Red"
                    Text="*API calls may not be exact. The actual detected serial number will be used when the target serial number is not case sensitive." />
            </StackPanel>
            <TextBox
                x:Name="APICall1TextBlock"
                Margin="12,6,0,0"
                Background="Transparent"
                BorderThickness="0"
                IsReadOnly="True"
                TextWrapping="Wrap" />
            <TextBox
                x:Name="APICall2TextBlock"
                Margin="12,6,0,0"
                Background="Transparent"
                BorderThickness="0"
                IsReadOnly="True"
                TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel
            Grid.Row="2"
            Margin="12,12,12,0"
            Orientation="Horizontal">
            <Button
                x:Name="MonitorForResultButton"
                Grid.Row="2"
                Width="125"
                HorizontalAlignment="Left"
                Click="MonitorForResultButton_Click"
                Content="Monitor for Result" />
            <Button
                x:Name="CancelButton"
                Grid.Row="2"
                Width="125"
                Margin="12,0,0,0"
                HorizontalAlignment="Left"
                Click="CancelButton_Click"
                Content="Cancel" />
        </StackPanel>
        <StackPanel Grid.Row="3" Margin="12,12,12,0">
            <StackPanel Orientation="Horizontal">
                <TextBlock VerticalAlignment="Center" Text="API Calls:" />
                <TextBlock
                    Margin="12,0,0,0"
                    VerticalAlignment="Center"
                    Foreground="Red"
                    Text="*API calls may not be exact. The actual detected serial number will be used when the target serial number is not case sensitive." />
            </StackPanel>
            <TextBox
                x:Name="APICall3TextBlock"
                Margin="12,6,0,0"
                Background="Transparent"
                BorderThickness="0"
                IsReadOnly="True"
                TextWrapping="Wrap" />
            <TextBox
                x:Name="APICall4TextBlock"
                Margin="12,6,0,0"
                Background="Transparent"
                BorderThickness="0"
                IsReadOnly="True"
                TextWrapping="Wrap" />
            <!--<TextBlock
                x:Name="APICall3TextBlock"
                Margin="12,6,0,0"
                Text="" />
            <TextBlock
                x:Name="APICall4TextBlock"
                Margin="12,6,0,0"
                Text="" />-->
        </StackPanel>
        <Button
            x:Name="StartPollingBackupButton"
            Grid.Row="4"
            Width="125"
            Margin="12,12,12,0"
            HorizontalAlignment="Left"
            Click="StartPollingBackupButton_Click"
            Content="Start Polling Backup" />
        <TextBlock
            Grid.Row="5"
            Margin="12,12,12,0"
            Text="Response:" />
        <RichTextBox
            x:Name="JSONResponseRichTextBox"
            Grid.Row="6"
            Margin="12,3,12,0"
            Background="Black"
            IsReadOnly="True"
            IsReadOnlyCaretVisible="False"
            VerticalScrollBarVisibility="Auto" />
    </Grid>
</Page>
