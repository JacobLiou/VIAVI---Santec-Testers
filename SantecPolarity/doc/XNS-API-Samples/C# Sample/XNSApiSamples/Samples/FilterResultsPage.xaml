<Page
    x:Class="XNSApiSamples.Samples.FilterResultsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:XNSApiSamples.Samples"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="FilterResultsPage"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel
            Grid.Row="0"
            Margin="12,12,12,0"
            Orientation="Horizontal">
            <TextBlock VerticalAlignment="Center" Text="Start Date:" />
            <TextBox
                x:Name="StartDateTextBox"
                Width="250"
                Margin="12,0,0,0"
                Text=""
                TextChanged="StartDateTextBox_TextChanged" />
            <TextBlock
                Margin="6,0,0,0"
                VerticalAlignment="Center"
                Foreground="Red"
                Text="*Date and time must be expressed in ISO 8601 format" />
        </StackPanel>
        <StackPanel
            Grid.Row="1"
            Margin="12,12,12,0"
            Orientation="Horizontal">
            <TextBlock
                Width="55"
                VerticalAlignment="Center"
                Text="End Date:" />
            <TextBox
                x:Name="EndDateTextBox"
                Width="250"
                Margin="12,0,0,0"
                Text=""
                TextChanged="EndDateTextBox_TextChanged" />
        </StackPanel>
        <StackPanel
            Grid.Row="2"
            Margin="12,12,12,0"
            Orientation="Horizontal">
            <TextBlock VerticalAlignment="Center" Text="API Call:" />
            <TextBox
                x:Name="APICallTextBlock"
                Margin="12,0,0,0"
                Background="Transparent"
                BorderThickness="0"
                IsReadOnly="True"
                TextWrapping="Wrap" />
            <!--<TextBlock
                x:Name="APICallTextBlock"
                Margin="12,0,0,0"
                Text="" />-->
        </StackPanel>
        <Button
            x:Name="FilterResultsButton"
            Grid.Row="3"
            Width="125"
            Margin="12,12,12,0"
            HorizontalAlignment="Left"
            Click="FilterResultsButton_Click"
            Content="Filter Results" />
        <StackPanel Grid.Row="4" Orientation="Horizontal">
            <TextBlock
                Grid.Row="4"
                Margin="12,12,12,0"
                Text="Response:" />
            <TextBlock
                Margin="0,12,0,0"
                Foreground="Red"
                Text="*This API call returns results for a maximum of 10000 DUTs" />
        </StackPanel>
        <RichTextBox
            x:Name="JSONResponseRichTextBox"
            Grid.Row="5"
            Margin="12,3,12,0"
            Background="Black"
            IsReadOnly="True"
            IsReadOnlyCaretVisible="False"
            VerticalScrollBarVisibility="Auto" />
    </Grid>
</Page>
